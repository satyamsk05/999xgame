# Copy this file to .env.aws on the EC2 host.
# NEVER commit the real .env.aws file.

# Supabase PostgreSQL (project: 999xgame, Mumbai/ap-south-1)
DB_HOST=db.ssmciyzhvftnczdokwoo.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=CHANGE_THIS_TO_YOUR_SUPABASE_DATABASE_PASSWORD
DB_SSL=true

# Public API origin. For the first HTTP-only smoke test you can use the EC2 public URL.
# For production mobile builds, use HTTPS on your own domain.
CORS_ORIGIN=http://YOUR_DOMAIN_OR_IP

TRUST_PROXY=true
BODY_LIMIT=1mb
LOG_LEVEL=info
MAINTENANCE_MODE=false
MINIMUM_APP_VERSION=1.0.0

JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
ADMIN_JWT_SECRET=CHANGE_THIS_TO_A_DIFFERENT_LONG_RANDOM_SECRET
JWT_ISSUER=999xgame
JWT_AUDIENCE=999xgame-app
ADMIN_JWT_AUDIENCE=999xgame-admin
JWT_TTL_SECONDS=604800
ADMIN_JWT_TTL_SECONDS=43200
ADMIN_BREAK_GLASS_ENABLED=false
ADMIN_BREAK_GLASS_SECRET=

# Redis remains local to the EC2 host.
REDIS_HOST=redis
REDIS_PORT=6379

# Keep empty only if your current development/test flow does not require them.
LOGGIN_APP_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
PAYMENT_UPI_ID=
PAYMENT_MERCHANT_NAME=999x InGames Platform
