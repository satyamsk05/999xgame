# =============================================================================
# 999xGame / InGames backend — environment template (sec 62)
# Copy to `.env` and fill in real values. NEVER commit real secrets.
# Production startup FAILS CLOSED if required secrets are missing or left at
# their insecure dev defaults (see src/config/env.js validateConfig).
# =============================================================================

NODE_ENV=production
PORT=5050
LOG_LEVEL=info

# Restrict to explicit comma-separated origins in production (not "*").
CORS_ORIGIN=

# --- PostgreSQL (the ONLY authoritative financial database) -------------------
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL=true

# --- Redis (cache / pub-sub / worker locking; NOT authoritative for money) ----
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT secrets (min 32 chars each in production) ---------------------------
# USER app tokens and ADMIN tokens use SEPARATE secrets and audiences.
JWT_SECRET=
ADMIN_JWT_SECRET=

# Optional JWT tuning (defaults shown).
JWT_ISSUER=999xgame
JWT_AUDIENCE=999xgame-app
ADMIN_JWT_AUDIENCE=999xgame-admin
JWT_TTL_SECONDS=604800
ADMIN_JWT_TTL_SECONDS=43200

# --- Emergency admin break-glass (DISABLED by default — sec 6) ---------------
# The legacy X-Admin-Secret master bypass is removed. This isolated mechanism
# only activates when ENABLED=true with a dedicated strong secret, and every use
# is logged loudly. Leave disabled in normal operation.
ADMIN_BREAK_GLASS_ENABLED=false
ADMIN_BREAK_GLASS_SECRET=

# --- Loggin.dev WhatsApp OTP auth --------------------------------------------
LOGGIN_APP_KEY=

# --- Telegram notifications (non-authoritative; never rolls back money) -------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Payments / UPI display --------------------------------------------------
PAYMENT_UPI_ID=
PAYMENT_MERCHANT_NAME=
