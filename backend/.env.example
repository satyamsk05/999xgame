# =============================================================================
# 999xGame / InGames backend — environment template
# NEVER commit real secrets. Production startup fails closed on missing required values.
# =============================================================================

NODE_ENV=production
PORT=5050
LOG_LEVEL=info

# AWS ALB / reverse proxy
TRUST_PROXY=true
BODY_LIMIT=1mb

# Explicit frontend origins, comma-separated. Never use * in production.
CORS_ORIGIN=https://your-production-app.example

# Runtime app configuration
MAINTENANCE_MODE=false
MINIMUM_APP_VERSION=1.0.0
ONLINE_TICKER_RING_COLORS=#FFC107,#FF9800,#4FC3F7
ONLINE_TICKER_AVATARS=/avatars/avatar_1.png,/avatars/avatar_2.png,/avatars/avatar_3.png

# --- PostgreSQL (ONLY authoritative financial database) ----------------------
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL=true

# --- Redis (cache / pub-sub / worker locking; NOT authoritative for money) ----
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT secrets --------------------------------------------------------------
JWT_SECRET=
ADMIN_JWT_SECRET=
JWT_ISSUER=999xgame
JWT_AUDIENCE=999xgame-app
ADMIN_JWT_AUDIENCE=999xgame-admin
JWT_TTL_SECONDS=604800
ADMIN_JWT_TTL_SECONDS=43200

# --- Emergency admin break-glass (normally disabled) -------------------------
ADMIN_BREAK_GLASS_ENABLED=false
ADMIN_BREAK_GLASS_SECRET=

# --- OTP / notifications -----------------------------------------------------
LOGGIN_APP_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Payments / UPI display ---------------------------------------------------
PAYMENT_UPI_ID=
PAYMENT_MERCHANT_NAME=
